#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Weights { uint packed[]; };
layout(set=0,binding=1,std430) readonly buffer Input { float x[]; };
layout(set=0,binding=2,std430) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Params { uint rows; uint columns; } p;
shared float sums[64];
uint byteAt(uint offset) { return (packed[offset>>2]>>((offset&3)*8))&255; }
void main() {
    uint row=gl_WorkGroupID.x, lane=gl_LocalInvocationID.x;
    precise float total=0;
    for(uint col=lane;col<p.columns;col+=64) {
        uint offset=(row*(p.columns/32)+col/32)*34;
        float scale=unpackHalf2x16(byteAt(offset)|(byteAt(offset+1)<<8)).x;
        int q=int(byteAt(offset+2+col%32));
        if(q>=128) q-=256;
        precise float product=float(q)*x[col];
        total+=scale*product;
    }
    sums[lane]=total; barrier();
    for(uint stride=32;stride>0;stride>>=1) {
        if(lane<stride) { precise float sum=sums[lane]+sums[lane+stride]; sums[lane]=sum; }
        barrier();
    }
    if(lane==0) y[row]=sums[0];
}
