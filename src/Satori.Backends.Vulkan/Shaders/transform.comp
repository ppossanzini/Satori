#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input { float x[]; };
layout(set=0,binding=1,std430) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Params { uint count; } p;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i<p.count) y[i]=2*x[i]+1;
}
