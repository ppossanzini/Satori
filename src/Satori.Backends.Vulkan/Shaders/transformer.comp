#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) buffer Arena { float v[]; };
layout(set=0,binding=1,std430) readonly buffer Tables { float t[]; };
layout(push_constant) uniform Params { uint op; uint a; uint b; uint c; uint n; uint position; uint layer; uint table; } p;
shared float sums[64];
void main() {
    uint lane=gl_LocalInvocationID.x;
    if(p.op==0) {
        precise float sum=0;
        for(uint i=lane;i<p.n;i+=64) { precise float sq=v[p.a+i]*v[p.a+i]; sum+=sq; }
        sums[lane]=sum; barrier();
        for(uint stride=32;stride>0;stride>>=1) { if(lane<stride) sums[lane]+=sums[lane+stride]; barrier(); }
        float scale=inversesqrt(sums[0]/float(p.n)+1e-5);
        for(uint i=lane;i<p.n;i+=64) v[p.c+i]=(v[p.a+i]*scale)*t[p.b+i];
    }
    if(p.op==1) {
        for(uint i=lane*2;i<p.n;i+=128) {
            uint pair=(i%48)/2;
            float sn=t[p.table+(p.position*24+pair)*2], cs=t[p.table+(p.position*24+pair)*2+1];
            float x=v[p.a+i], y=v[p.a+i+1];
            precise float xr=x*cs-y*sn, yr=x*sn+y*cs;
            v[p.a+i]=xr;v[p.a+i+1]=yr;
        }
    }
    if(p.op==2) {
        for(uint i=lane;i<p.n;i+=64) {
            float x=v[p.a+i];float e=exp(-abs(x));float sigmoid=x>=0?1/(1+e):e/(1+e);
            v[p.c+i]=(x*sigmoid)*v[p.b+i];
        }
    }
}
